{
  "name": "malastranapp-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "db:migrate": "wrangler d1 execute malastranapp-db --file=src/db/migrations/001_init.sql",
    "db:seed": "wrangler d1 execute malastranapp-db --file=src/db/migrations/001_init.sql",
    "db:reset": "wrangler d1 execute malastranapp-db --command=\"DROP TABLE IF EXISTS assignments; DROP TABLE IF EXISTS notifications; DROP TABLE IF EXISTS availability; DROP TABLE IF EXISTS materials; DROP TABLE IF EXISTS costumes; DROP TABLE IF EXISTS collaborators; DROP TABLE IF EXISTS events; DROP TABLE IF EXISTS users;\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.121.23",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "elysia": "^1.3.5",
    "hono": "^4.8.3",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260520.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "@tanstack/router-plugin": "^1.121.23",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "typescript-eslint": "^8.33.1",
    "wrangler": "^4.17.0"
  }
}
